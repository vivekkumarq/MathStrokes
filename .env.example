# ---------------------------------------------------------------------------
# MathStrokes - environment template
# Copy to .env, fill in real values, and never commit the result.
# ---------------------------------------------------------------------------

# ---- Database ----
# Local PostgreSQL 17. Create the database and role first; see README.
DATABASE_URL=jdbc:postgresql://localhost:5432/mathstrokes
DATABASE_USERNAME=mathstrokes
DATABASE_PASSWORD=change-me

# ---- JWT ----
# Must be at least 32 characters. Generate with:
#   openssl rand -base64 48
# The application refuses to start with a shorter secret.
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_ACCESS_TOKEN_EXPIRATION=PT15M
JWT_REFRESH_TOKEN_EXPIRATION=P7D
JWT_PASSWORD_RESET_TOKEN_EXPIRATION=PT10M

# ---- CORS ----
# Comma separated. Must include the origin the Angular app is served from.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# ---- Profile and port ----
SPRING_PROFILES_ACTIVE=dev
PORT=8080

# ---- First-run seed ----
# The bootstrap seeder creates the admin account only when all three values are
# present and no admin exists yet. Leave blank in production to skip seeding.
SEED_ENABLED=true
SEED_ADMIN_NAME=Platform Administrator
SEED_ADMIN_PHONE=9000000001
SEED_ADMIN_PASSWORD=change-me-before-first-run
SEED_ADMIN_SECURITY_QUESTION=In which city were you born?
SEED_ADMIN_SECURITY_ANSWER=change-me

# ---- Rate limiting ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_ATTEMPTS=10
RATE_LIMIT_WINDOW_SECONDS=300

# ---- Swagger in production (leave false unless investigating) ----
SWAGGER_ENABLED=false
